FRONTEND_PORT=8080

# Deploy (optional): use prebuilt Docker images instead of building on the server.
# Recommended for small EC2 instances to avoid SSH freezes during build.
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=edmilsonfernandes
# Use `main` to always track the last successful publish or a short commit SHA for deterministic deploys.
IMAGE_TAG=main
# Recommended on EC2: read GHCR credentials from the same JSON parameter already used in production SSM.
AWS_REGION=us-east-2
SSM_PARAMETER_NAME=
# Optional: use a dedicated JSON parameter for GHCR instead of the shared app parameter above.
GHCR_SSM_PARAMETER_NAME=

# Frontend build metadata (recommended in production for version traceability in UI/SuperAdmin)
# Example before deploy:
# FRONTEND_BUILD_VERSION=1.2.3
# FRONTEND_BUILD_GIT_SHA=$(git rev-parse HEAD)
# FRONTEND_BUILD_GIT_SHORT_SHA=$(git rev-parse --short HEAD)
# FRONTEND_BUILD_GIT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
# FRONTEND_BUILD_TIME_ISO=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
# Optional (base64-encoded JSON string with commits; generated automatically by deploy-frontend.sh)
FRONTEND_BUILD_VERSION=
FRONTEND_BUILD_GIT_SHA=
FRONTEND_BUILD_GIT_SHORT_SHA=
FRONTEND_BUILD_GIT_BRANCH=
FRONTEND_BUILD_GIT_REMOTE_URL=
FRONTEND_BUILD_TIME_ISO=
FRONTEND_BUILD_COMMITS_B64=

# Postgres (docker compose)
# Use these to keep API and DB credentials aligned.
POSTGRES_DB=espetinho
POSTGRES_PASSWORD=postgres
# Pin the volume name to prevent accidental data loss when compose project name/path changes.
POSTGRES_VOLUME_NAME=edespetohub_postgres-data
REDIS_VOLUME_NAME=edespetohub_redis-data

# Delivery / Motoboy intelligent management (optional; defaults are safe)
APP_TZ=America/Sao_Paulo
DELIVERY_EXPIRE_MINUTES=20
DELIVERY_EXPIRATION_INTERVAL_MS=120000
DELIVERY_EXPIRATION_JOB_ENABLED=true

# pgAdmin (optional — only if you run pgAdmin in production)
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
