APP_BASE_URL=
CORS_ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=1
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
PENDING_SIGNUP_TTL_DAYS=7
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_OAUTH_REDIRECT_URL=
MP_OAUTH_ENCRYPTION_KEY=
MP_WEBHOOK_URL=
MP_WEBHOOK_SECRET=
MP_API_BASE_URL=https://api.mercadopago.com
MP_DEBUG=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
TRIAL_DAYS=7
NOTIFY_ON_SIGNUP_EMAILS=contato@janocaminho.com.br,edmls2008@gmail.com
FIRST_MONTH_PROMO_PRICE=14.90
SMTP_SECURE=false
EMAIL_FROM=Jano Caminho <contato@janocaminho.com.br>

# Postal tracking provider (optional)
SHIPPING_TRACKING_PROVIDER=manual
SHIPPING_TRACKING_REFRESH_STALE_MINUTES=180
SITE_RASTREIO_API_KEY=
SITE_RASTREIO_BASE_URL=https://api-labs.wonca.com.br/wonca.labs.v1.LabsService
SITE_RASTREIO_TIMEOUT_MS=8000

# Optional fallback only: lets the server authenticate to GHCR before pull-only deploys.
# Prefer `SSM_PARAMETER_NAME` or `GHCR_SSM_PARAMETER_NAME` in `.env.prod` and keep GHCR_USERNAME/GHCR_TOKEN inside that JSON.
# Create a GitHub PAT with `read:packages` and store it only on the server if you are not using SSM.
GHCR_USERNAME=
GHCR_TOKEN=

# Optional: if you use SSM to set PG* values in the API, define these too and keep them consistent with Postgres.
# POSTGRES_PASSWORD is used by docker-compose.yml for the postgres container.
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_VOLUME_NAME=
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=
DB_POOL_MAX=
DB_POOL_IDLE_TIMEOUT_MS=
DB_POOL_CONNECTION_TIMEOUT_MS=
DB_STATEMENT_TIMEOUT_MS=
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=
JWT_SECRET=

# Redis (docker compose) — leave empty to disable caching
# REDIS_URL=redis://redis:6379
# REDIS_TTL_DEFAULT_SECONDS=60

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=25
AUTH_RECOVERY_RATE_LIMIT_WINDOW_MS=900000
AUTH_RECOVERY_RATE_LIMIT_MAX=10
REQUIRE_STRICT_RUNTIME_VALIDATION=true

# pgAdmin (only if the pgAdmin container runs in production)
PGADMIN_DEFAULT_PASSWORD=
