{
  "name": "espetinho-platform-backend",
  "version": "1.0.0",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "db:reset": "ts-node src/scripts/resetDatabase.ts",
    "backfill:customer-addresses": "ts-node src/scripts/backfillCustomerAddressCoordinates.ts",
    "seed:condominium:azuli": "ts-node src/scripts/seedCondominiumAzuli.ts",
    "seed:condominium-users": "ts-node src/scripts/seedCondominiumUsers.ts",
    "test": "node node_modules/vitest/vitest.mjs run --config vitest.config.unit.ts && node node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:watch": "node node_modules/vitest/vitest.mjs --config vitest.config.unit.ts",
    "test:e2e": "node node_modules/vitest/vitest.mjs run",
    "test:e2e:watch": "node node_modules/vitest/vitest.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.967.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.15",
    "pg": "^8.11.5",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.13",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.13",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.6",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.5"
  }
}
