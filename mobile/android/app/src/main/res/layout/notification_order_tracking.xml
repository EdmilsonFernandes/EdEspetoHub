<?xml version="1.0" encoding="utf-8"?>
<!--
  Notificacao ongoing de acompanhamento (visao colapsada) — minimalista.
  O cabecalho (icone do app + "Ja no Caminho" + horario) e adicionado automaticamente pelo
  sistema. Aqui so: status atual (grande) + barra de progresso. Sem nome de loja, sem logo,
  sem lista de etapas.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingEnd="2dp"
    android:paddingTop="4dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/notif_track_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="Pedido em andamento" />

    <ProgressBar
        android:id="@+id/notif_track_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/notif_progress_horizontal" />
</LinearLayout>
