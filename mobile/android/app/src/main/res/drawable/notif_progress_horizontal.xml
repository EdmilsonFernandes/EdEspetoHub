<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de progresso da notificacao ongoing — trilha translúcida neutra
     (funciona em bandeja clara E escura, 19/08) + azul da marca no progresso. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#66777777" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="#2F9DF7" />
                <corners android:radius="3dp" />
            </shape>
        </clip>
    </item>
</layer-list>
